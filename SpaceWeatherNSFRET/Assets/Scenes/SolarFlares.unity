  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Real-World Impact on Earth\r\n\nBackground solar noise with zero impact
    on Earth.\r\n\nNo notice or impact on Earth.\r\n\nNoticeable on solar instruments,
    but too weak to cause significant disturbances on Earth.\r\n\nCan trigger brief
    radio blackouts at Earth's poles and minor radiation storms. Minor gps disturbances.\n\nCause
    continent-wide radio blackouts, damage satellites, and disrupt power grids. Major
    gps disturbances.\n                        "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
